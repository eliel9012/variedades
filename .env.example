VITE_TSE_RESULTS_CONFIG_URL=https://resultados.tse.jus.br/oficial/comum/config/ele-c.jws

# Analytics opcional via Umami (self-hosted). Sem essas duas, o site roda
# normal e não carrega nenhum script de analytics (ver src/analytics.ts).
# Veja README > "Analytics (Umami)".
VITE_UMAMI_SCRIPT_URL=https://analytics.meulab.fun/script.js
VITE_UMAMI_WEBSITE_ID=

# Anúncio opcional, desligado por padrão. Só carrega se VITE_AD_SCRIPT_URL
# estiver preenchido E a pessoa aceitar no banner de cookies (ver src/ads.ts,
# src/cookie-consent.ts). Veja README > "Rede de anúncios" pra recomendação
# de rede e onde pegar cada ID.
VITE_AD_SCRIPT_URL=
VITE_AD_CLIENT_ID=

# ID de unidade de anúncio por posição (header/rodapé/lateral/no texto). Sem
# um ID aqui, aquela posição específica nunca mostra nada, mesmo com
# VITE_AD_SCRIPT_URL preenchido e cookie aceito.
VITE_AD_SLOT_HEADER=
VITE_AD_SLOT_FOOTER=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_INCONTENT=
