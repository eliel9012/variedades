[Unit]
Description=Apura Brasil (vigia: alertas no Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/variedades
EnvironmentFile=/etc/apura-telegram.env
ExecStart=/usr/bin/node scripts/watchdog.mjs
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
