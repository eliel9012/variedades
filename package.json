{
  "name": "apura-brasil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync:tse": "node scripts/sync-tse.mjs",
    "sync:polls": "node scripts/sync-polls.mjs",
    "check": "tsc -b",
    "server": "node server/index.mjs",
    "start": "node server/web.mjs",
    "ingest": "node scripts/ingest-tse.mjs",
    "deploy": "npm run build && systemctl restart apura-brasil && sleep 2 && scripts/purge-cf.sh && npm run warm-og",
    "warm-og": "nohup node scripts/warm-og.mjs > /tmp/apura-warm-og.log 2>&1 &"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
